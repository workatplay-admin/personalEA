# PersonalEA Environment Configuration
# =====================================
# Copy this file to .env and fill in your actual values
# DO NOT commit your .env file to version control!

# =============================================================================
# REQUIRED API KEYS - Application will not start without these
# =============================================================================

# OpenAI API Key (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
# Format: sk-[alphanumeric string]
OPENAI_API_KEY=sk-YOUR-OPENAI-API-KEY-HERE

# Claude API Key (Optional - for Claude integration)
# Get your API key from: https://console.anthropic.com/
# Format: sk-ant-[alphanumeric string]
# CLAUDE_API_KEY=sk-ant-YOUR-CLAUDE-API-KEY-HERE

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================

# JWT Secret - Used for authentication tokens (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Session Secret - Used for web sessions (min 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Email Encryption Key - Must be exactly 32 characters
# Generate with: openssl rand -hex 16
EMAIL_ENCRYPTION_KEY=your32characterencryptionkeyhere

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# PostgreSQL Database
POSTGRES_PASSWORD=your-secure-database-password
DATABASE_URL=postgresql://personalea:your-secure-database-password@localhost:5432/personalea

# Redis Cache
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@localhost:6379

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment Mode
NODE_ENV=production

# Service Ports
GOAL_STRATEGY_PORT=3000
EMAIL_SERVICE_PORT=3001
FRONTEND_PORT=5173

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# =============================================================================
# OPTIONAL EMAIL INTEGRATION
# =============================================================================

# Gmail API Configuration (Optional - for Gmail integration)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-gmail-client-secret
# GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback