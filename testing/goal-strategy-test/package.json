{
  "name": "goal-strategy-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "mock-api": "node mock-api-server.js",
    "openai-api": "node openai-api-server.js",
    "test-env": "concurrently \"npm run mock-api\" \"npm run dev\"",
    "test-env-openai": "concurrently \"npm run openai-api\" \"npm run dev\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:tdd": "vitest --watch --reporter=verbose",
    "test:phase1": "vitest run --reporter=verbose src/tests/phase1",
    "test:phase2": "vitest run --reporter=verbose src/tests/phase2",
    "test:phase3": "vitest run --reporter=verbose src/tests/phase3",
    "test:integration": "vitest run --reporter=verbose src/tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:phase1": "playwright test tests/e2e/phase1",
    "test:e2e:phase2": "playwright test tests/e2e/phase2",
    "test:e2e:phase3": "playwright test tests/e2e/phase3",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:e2e:integration": "playwright test tests/e2e/integration",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:e2e:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --project=\"Microsoft Edge\"",
    "test:e2e:performance": "playwright test tests/e2e/integration/full-workflow.spec.ts --project=chromium --repeat-each=3",
    "test:e2e:report": "playwright show-report",
    "test:e2e:trace": "playwright show-trace",
    "test:browsers:install": "playwright install",
    "test:browsers:install-deps": "playwright install-deps",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:contract": "pact-broker can-i-deploy",
    "test:performance": "vitest run --reporter=verbose src/tests/performance",
    "test:all": "npm run test && npm run test:e2e",
    "test:ci": "npm run test:e2e:cross-browser -- --reporter=junit",
    "test:automated": "./run-automated-tests.sh",
    "test:automated:real-api": "OPENAI_API_KEY=$OPENAI_API_KEY ./run-automated-tests.sh --real-api",
    "test:automated:headed": "./run-automated-tests.sh --headed",
    "test:automated:cross-browser": "./run-automated-tests.sh --browser=all",
    "test:comprehensive": "node comprehensive-test-runner.js",
    "test:comprehensive:real-api": "USE_REAL_API=true node comprehensive-test-runner.js",
    "test:comprehensive:ci": "CI=true node comprehensive-test-runner.js"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "better-queue": "^3.8.12",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.294.0",
    "openai": "^5.5.1",
    "opossum": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^12.5.2",
    "@pact-foundation/pact-node": "^10.18.0",
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.16",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-check": "^3.23.2",
    "happy-dom": "^12.10.3",
    "jsdom": "^23.2.0",
    "msw": "^2.10.2",
    "playwright": "^1.53.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.6.1"
  }
}
