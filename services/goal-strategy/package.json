{
  "name": "@personalea/goal-strategy-service",
  "version": "1.0.0",
  "description": "Goal & Strategy Service - Sophisticated 8-step goal-setting and strategic planning workflow",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node -r module-alias/register dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/services --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:browser": "jest tests/browser --detectOpenHandles",
    "test:phase2-3": "npm run test:unit && npm run test:integration",
    "test:all": "npm run test:phase2-3 && npm run test:browser",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset"
  },
  "keywords": [
    "goal-setting",
    "strategy",
    "planning",
    "ai",
    "smart-goals",
    "task-management",
    "microservice"
  ],
  "author": "PersonalEA Team",
  "license": "MIT",
  "dependencies": {
    "@dabh/diagnostics": "^2.0.3",
    "@prisma/client": "^5.7.1",
    "async": "^3.2.6",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.5.0",
    "enabled": "^2.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fecha": "^4.2.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "kuler": "^2.0.0",
    "module-alias": "^2.2.3",
    "ms": "^2.1.3",
    "one-time": "^1.0.0",
    "openai": "^4.20.1",
    "safe-stable-stringify": "^2.5.0",
    "triple-beam": "^1.4.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-transport": "^4.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-playwright-preset": "^4.0.0",
    "logform": "^2.7.0",
    "playwright": "^1.40.1",
    "prisma": "^5.7.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "_moduleAliases": {
    "@": "dist",
    "@/config": "dist/config",
    "@/middleware": "dist/middleware",
    "@/routes": "dist/routes",
    "@/services": "dist/services",
    "@/types": "dist/types",
    "@/utils": "dist/utils"
  }
}
