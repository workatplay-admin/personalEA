# PersonalEA Staging Environment Configuration
# Copy this file to .env.staging and update with your values

# ⚠️ CRITICAL PRIVACY NOTICE:
# This staging environment VIOLATES the core "You-First" data control principle
# - Uses shared API keys instead of user-controlled keys
# - No user-controlled encryption
# - No consent management for external API calls
# Do NOT enter sensitive personal information during testing

# OpenAI API Configuration (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Database Configuration (Staging)
DB_PASSWORD=staging_secure_password_change_in_production
DATABASE_URL=postgresql://staging_user:staging_secure_password_change_in_production@localhost:5432/personalea_staging

# Redis Configuration (Staging)
REDIS_PASSWORD=staging_redis_password_change_in_production
REDIS_URL=redis://:staging_redis_password_change_in_production@localhost:6379

# JWT Configuration (Staging)
JWT_SECRET=staging-jwt-secret-at-least-32-characters-long-change-in-production
SESSION_SECRET=staging-session-secret-at-least-32-characters-long-change-in-production

# Encryption Configuration (Staging)
EMAIL_ENCRYPTION_KEY=staging-32-char-encryption-key-001

# Logging Configuration
LOG_LEVEL=debug

# CORS Configuration for Testing
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Staging Environment Flags
NODE_ENV=staging
STAGING_MODE=true
PRIVACY_WARNING=true

# Service URLs (for container communication)
GOAL_STRATEGY_SERVICE_URL=http://goal-strategy-service:3000
EMAIL_PROCESSING_SERVICE_URL=http://email-processing-service:3001

# External Service Configuration (PRIVACY VIOLATION WARNING)
# In production, these should be user-controlled, not shared
# Current implementation violates data sovereignty principles

# Gmail API Configuration (TESTING ONLY - Limited functionality)
# GMAIL_CLIENT_ID=your-gmail-client-id-here
# GMAIL_CLIENT_SECRET=your-gmail-client-secret-here
# GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# Google Calendar API Configuration (SERVICE MISSING)
# GOOGLE_CALENDAR_CLIENT_ID=your-calendar-client-id-here
# GOOGLE_CALENDAR_CLIENT_SECRET=your-calendar-client-secret-here
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3003/auth/google/callback

# Feature Flags for Testing
ENABLE_AI_PROCESSING=true
ENABLE_GOAL_TRANSLATION=true
ENABLE_TASK_BREAKDOWN=true
ENABLE_ESTIMATION=true
ENABLE_DEPENDENCIES=true
ENABLE_MILESTONES=true

# Disabled features (missing services or privacy framework)
ENABLE_CALENDAR_INTEGRATION=false
ENABLE_EMAIL_SYNC=false
ENABLE_DATA_SOVEREIGNTY=false
ENABLE_USER_ENCRYPTION=false
ENABLE_CONSENT_MANAGEMENT=false

# Testing Configuration
TESTING_MODE=true
MOCK_EXTERNAL_APIS=false
DISABLE_RATE_LIMITING=true
ENABLE_DEBUG_LOGS=true

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Performance Configuration (for testing)
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30000
AI_PROCESSING_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=5000

# Data Retention (Staging - NOT for production)
# In production, this should be user-controlled
SESSION_TIMEOUT=24h
DATA_RETENTION_DAYS=7
LOG_RETENTION_DAYS=3

# Analytics and Monitoring (Development only)
ENABLE_ANALYTICS=false
ANALYTICS_ENDPOINT=
MONITORING_ENDPOINT=

# Security Configuration (DEVELOPMENT ONLY)
# These settings are NOT suitable for production
DISABLE_CSRF_PROTECTION=true
DISABLE_RATE_LIMITING=true
ALLOW_HTTP=true
DISABLE_SECURE_COOKIES=true

# Container Configuration
POSTGRES_VERSION=14-alpine
REDIS_VERSION=7-alpine
NODE_VERSION=18-alpine

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=personalea-staging
COMPOSE_FILE=docker-compose.staging.yml

# Development Helpers
AUTO_RESTART=true
REBUILD_ON_CHANGE=false
ENABLE_HOT_RELOAD=true

# Resource Limits (for development containers)
POSTGRES_MAX_CONNECTIONS=20
REDIS_MAX_MEMORY=256mb
NODE_MAX_MEMORY=512mb

# Backup Configuration (Staging)
ENABLE_AUTO_BACKUP=false
BACKUP_RETENTION_DAYS=1
BACKUP_LOCATION=./staging/backups

# Notification Configuration (Disabled for staging)
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WEBHOOK_NOTIFICATIONS=false
NOTIFICATION_ENDPOINT=

# Third-party Service Configuration
# Note: In production, these should be user-provided, not centrally managed
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# API Rate Limiting (Development)
OPENAI_RATE_LIMIT=60
DATABASE_RATE_LIMIT=1000
API_RATE_LIMIT=100

# Development Tools
ENABLE_API_DOCS=true
ENABLE_SWAGGER_UI=true
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_DEBUG_ENDPOINTS=true

# Testing Data
SEED_TEST_DATA=true
TEST_USER_ID=test-user-staging-001
TEST_GOAL_DATA=true

# Privacy and Compliance (CURRENT STATUS: NOT IMPLEMENTED)
GDPR_COMPLIANCE=false
CCPA_COMPLIANCE=false
SOC2_COMPLIANCE=false
DATA_SOVEREIGNTY_ENABLED=false
USER_CONTROLLED_ENCRYPTION=false
CONSENT_MANAGEMENT_ENABLED=false
DATA_EXPORT_ENABLED=false
DATA_DELETION_ENABLED=false
AUDIT_LOGGING_ENABLED=false

# Future Configuration (when features are implemented)
CALENDAR_SERVICE_ENABLED=false
CALENDAR_SERVICE_URL=http://calendar-service:3003
FULL_WORKFLOW_ENABLED=false
ADVANCED_ANALYTICS_ENABLED=false
MACHINE_LEARNING_ENABLED=false

# Important Notes:
# 1. This is a DEVELOPMENT/STAGING environment
# 2. Data sovereignty principles are NOT implemented
# 3. Privacy controls are NOT available
# 4. Calendar service is completely missing
# 5. Do NOT use sensitive personal data for testing
# 6. Full PersonalEA requires significant additional development