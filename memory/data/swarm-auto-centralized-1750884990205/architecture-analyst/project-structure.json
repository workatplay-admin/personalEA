        "Unit tests with Vitest",
        "E2E tests with Playwright",
        "Integration tests",
        "Performance tests"
      ]
    },
    "main_tests": {
      "location": "tests/",
      "types": [
        "Playwright E2E",
        "Pact contract testing",
        "Dredd API testing"
      ]
    }
  },
