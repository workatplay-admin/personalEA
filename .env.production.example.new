# PersonalEA Production Environment Configuration
# =====================================================
# This file contains all configuration settings for production deployment
# Copy this file to .env and fill in your actual values
# DO NOT commit your actual .env file to version control

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Environment Mode
NODE_ENV=production

# Application Name and Version
APP_NAME=PersonalEA
APP_VERSION=1.0.0

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Goal Strategy Service
GOAL_STRATEGY_PORT=3000
GOAL_STRATEGY_HOST=0.0.0.0

# Email Processing Service
EMAIL_SERVICE_PORT=3001
EMAIL_SERVICE_HOST=0.0.0.0

# Frontend UI
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0

# Health Monitor Dashboard
HEALTH_MONITOR_PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personalea
POSTGRES_USER=personalea
# Production secure password generated with openssl
POSTGRES_PASSWORD=Gdu6Yb1Pigle/K+lJa46ICTm7dRK62N39ZP/zLnzLTU=

# Database URLs for services
DATABASE_URL=postgresql://personalea:Gdu6Yb1Pigle/K+lJa46ICTm7dRK62N39ZP/zLnzLTU=@localhost:5432/personalea
GOAL_STRATEGY_DATABASE_URL=postgresql://personalea:Gdu6Yb1Pigle/K+lJa46ICTm7dRK62N39ZP/zLnzLTU=@localhost:5432/goal_strategy
EMAIL_SERVICE_DATABASE_URL=postgresql://personalea:Gdu6Yb1Pigle/K+lJa46ICTm7dRK62N39ZP/zLnzLTU=@localhost:5432/email_processing

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=2000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Cache and Queue
REDIS_HOST=localhost
REDIS_PORT=6379
# Production secure password generated with openssl
REDIS_PASSWORD=2sd2fZNGv0YWKb0dcRcWA702xrAqnl+DKLKwnO4sjIs=
REDIS_DB=0

# Redis URLs
REDIS_URL=redis://:2sd2fZNGv0YWKb0dcRcWA702xrAqnl+DKLKwnO4sjIs=@localhost:6379/0
REDIS_CACHE_URL=redis://:2sd2fZNGv0YWKb0dcRcWA702xrAqnl+DKLKwnO4sjIs=@localhost:6379/1
REDIS_QUEUE_URL=redis://:2sd2fZNGv0YWKb0dcRcWA702xrAqnl+DKLKwnO4sjIs=@localhost:6379/2

# Redis Connection Pool
REDIS_POOL_SIZE=5
REDIS_CONNECTION_TIMEOUT=5000

# =============================================================================
# SECURITY CONFIGURATION - CRITICAL!
# =============================================================================

# JWT Configuration
# Secure random string generated with openssl rand -base64 32
JWT_SECRET=5trLwyBPEbp4IYoBfEx0Z40IyNpcBLI3p2Hn9h7/214=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# Session Configuration
# Secure random string generated with openssl rand -base64 32
SESSION_SECRET=fAVTy+UxqeaiqPAnQAY3uvubPvo/cgwZcN4P4OWs0N4=
SESSION_TIMEOUT=28800 # 8 hours in seconds

# Email Encryption
# 32-byte hex string for AES-256 encryption generated with openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=20186cfb7c5acbb9abd666dc936ec465914f7c6995a31e3fd4b8c3dc3b828673

# =============================================================================
# API KEYS - REQUIRED FOR FUNCTIONALITY
# =============================================================================

# OpenAI API Configuration
# SECURITY: Replace with your actual OpenAI API key
# Never commit real API keys to version control!
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
OPENAI_REQUEST_TIMEOUT=30000
OPENAI_MAX_RETRIES=3

# Gmail API Configuration (Optional - for email integration)
# Get credentials from https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=YOUR_GMAIL_CLIENT_ID_HERE
GMAIL_CLIENT_SECRET=YOUR_GMAIL_CLIENT_SECRET_HERE
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# =============================================================================
# CORS AND SECURITY HEADERS
# =============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Security Headers
HELMET_ENABLED=true
CSRF_PROTECTION=true
XSS_PROTECTION=true

# =============================================================================
# RATE LIMITING AND THROTTLING
# =============================================================================

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# Login Attempt Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900000 # 15 minutes

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info # error, warn, info, debug
LOG_FORMAT=json # json, pretty
LOG_TIMESTAMP=true
LOG_COLORIZE=false

# File Logging
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/workspaces/personalEA/logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=10
LOG_FILE_COMPRESS=true

# Error Tracking (Optional)
# SENTRY_DSN=YOUR_SENTRY_DSN_HERE
# SENTRY_ENVIRONMENT=production

# Application Performance Monitoring (Optional)
# NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_KEY_HERE
# NEW_RELIC_APP_NAME=PersonalEA

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================

# Email Processing Settings
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_INTERVAL=900000 # 15 minutes
EMAIL_BATCH_SIZE=50
EMAIL_MAX_ATTACHMENT_SIZE=10485760 # 10MB
EMAIL_RETENTION_DAYS=365

# Email Queue Settings
EMAIL_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_RETRY_DELAY=60000 # 1 minute

# =============================================================================
# GOAL STRATEGY SERVICE CONFIGURATION
# =============================================================================

# AI Processing
AI_CONFIDENCE_THRESHOLD=0.7
AI_PROCESSING_TIMEOUT=30000
AI_MAX_CLARIFICATION_ROUNDS=3

# Goal Processing Features
FEATURE_AI_GOAL_TRANSLATION=true
FEATURE_MILESTONE_GENERATION=true
FEATURE_WBS_AUTOMATION=true
FEATURE_DEPENDENCY_MAPPING=true
FEATURE_ESTIMATION_ENGINE=true
FEATURE_CAPACITY_MANAGEMENT=true

# Estimation Configuration
ESTIMATION_LEARNING_ENABLED=true
ESTIMATION_MIN_SAMPLES=5
ESTIMATION_CONFIDENCE_INTERVAL=0.95
DEFAULT_WORK_HOURS_PER_DAY=8
DEFAULT_WORK_DAYS_PER_WEEK=5
CAPACITY_BUFFER_PERCENTAGE=20

# =============================================================================
# HEALTH CHECKS AND MONITORING
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000 # 30 seconds
HEALTH_CHECK_TIMEOUT=5000 # 5 seconds
HEALTH_CHECK_STARTUP_DELAY=10000 # 10 seconds
MAX_HEALTH_FAILURES=3

# Service Discovery
SERVICE_DISCOVERY_ENABLED=true
SERVICE_REGISTRY_URL=http://localhost:8500

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/workspaces/personalEA/backups

# =============================================================================
# FEATURE FLAGS AND EXPERIMENTS
# =============================================================================

# Feature Toggles
FEATURE_EMAIL_SYNC=true
FEATURE_CALENDAR_SYNC=false # Not implemented yet
FEATURE_AI_SUGGESTIONS=true
FEATURE_ADVANCED_ANALYTICS=false

# A/B Testing (Optional)
# OPTIMIZELY_SDK_KEY=YOUR_OPTIMIZELY_KEY_HERE
# LAUNCHDARKLY_SDK_KEY=YOUR_LAUNCHDARKLY_KEY_HERE

# =============================================================================
# EXTERNAL SERVICE URLS
# =============================================================================

# Internal Service Communication
GOAL_STRATEGY_SERVICE_URL=http://localhost:3000
EMAIL_SERVICE_URL=http://localhost:3001
CALENDAR_SERVICE_URL=http://localhost:8086 # Not implemented yet

# External APIs
OPENAI_API_URL=https://api.openai.com/v1
GMAIL_API_URL=https://gmail.googleapis.com

# =============================================================================
# DOCKER AND DEPLOYMENT
# =============================================================================

# Docker Configuration
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest
DOCKER_NETWORK=personalea_network

# Container Resource Limits
CONTAINER_MEMORY_LIMIT=512M
CONTAINER_CPU_LIMIT=0.5

# =============================================================================
# MAINTENANCE MODE
# =============================================================================

# Maintenance Settings
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="PersonalEA is currently undergoing maintenance. Please check back later."
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# =============================================================================
# INSTRUCTIONS FOR SETUP
# =============================================================================
# 
# 1. Copy this file: cp .env.production .env
# 2. Generate secure secrets:
#    - JWT_SECRET: openssl rand -base64 32
#    - SESSION_SECRET: openssl rand -base64 32
#    - EMAIL_ENCRYPTION_KEY: openssl rand -hex 16
# 3. Set secure passwords for:
#    - POSTGRES_PASSWORD
#    - REDIS_PASSWORD
# 4. Add your API keys:
#    - OPENAI_API_KEY (required)
#    - Gmail credentials (optional)
# 5. Adjust ports if needed to avoid conflicts
# 6. Review and adjust rate limits and timeouts
# 7. Configure logging paths and levels
# 8. Set up monitoring and alerting services (optional)
#
# For more detailed setup instructions, see: ./docs/deployment-guide.md